<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DumbNetwork.Views.PasswordDialog"
        Icon="/Assets/app.ico"
        Title="Права администратора"
        Width="480" Height="370"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#070C17">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0B1424" />
            <Setter Property="BorderBrush" Value="#24395F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Foreground" Value="#E8EEF9" />
            <Setter Property="CaretBrush" Value="#42E695" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="13,8" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#24395F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#B7C7E2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,9" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14213A" />
            <Setter Property="BorderBrush" Value="#3C5E96" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#42E695" />
            <Setter Property="BorderBrush" Value="#42E695" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#06120D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,9" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5AEEAA" />
            <Setter Property="BorderBrush" Value="#5AEEAA" />
        </Style>
    </Window.Styles>

    <Border Background="#0B1424"
            BorderBrush="#1B2A46"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28"
            Margin="10">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="Auto,*">
                <Border Width="42" Height="42" CornerRadius="11"
                        Background="#10251F" BorderBrush="#2A5B47" BorderThickness="1">
                    <Path Width="19" Height="19" Stretch="Uniform"
                          Fill="#42E695"
                          Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="ПРАВА АДМИНИСТРАТОРА" FontSize="10" FontWeight="Bold"
                               Foreground="#42E695" LetterSpacing="1.4" />
                    <TextBlock Text="Подтверждение для nfqws и nftables" FontSize="11"
                               Foreground="#5A6C8C" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Margin="0,20,0,16"
                       Text="Для включения DPI-обхода нужны права root. Введите пароль администратора: он будет передан только системному sudo и не сохранится."
                       FontSize="12.5" Foreground="#8194B5" TextWrapping="Wrap" LineHeight="19" />

            <TextBox Grid.Row="2"
                     x:Name="PasswordBox"
                     PasswordChar="●"
                     PlaceholderText="Пароль администратора" />

            <TextBlock Grid.Row="3"
                       x:Name="ErrorText"
                       Margin="1,9,0,0"
                       FontSize="11.5"
                       Foreground="#FF6B7A"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <TextBlock Text="Пароль не сохраняется приложением."
                           FontSize="10.5" Foreground="#5A6C8C"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Classes="secondary" Content="Отмена" Click="OnCancelClick" IsCancel="True" />
                <Button Classes="primary" Content="Подтвердить" Click="OnConfirmClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
